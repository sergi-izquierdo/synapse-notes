# Supabase - Get from: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key (server-only, bypasses RLS). Reserved for background agents
# (Week 4: Supabase Edge Functions with pg_cron). NOT used by the MCP server
# route; that path now does JWT passthrough + RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI - Get from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Anthropic (chat model: claude-haiku-4-5)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Cost-safety controls (TFG D4) ──────────────────────────────────
# Layer 5 — global kill-switch. Set to "false" to instantly disable
# every AI surface (chat, suggest-tags, MCP summarise-notes, embedding
# generation). Notes still save without embeddings (graceful
# degradation). Defaults to "true" so dev is frictionless.
AI_ENABLED=true

# Layer 3 — allowlist mode. When "true", only user_ids listed in
# AI_ALLOWLIST_USER_IDS can call AI surfaces. Production sets this to
# "true" to keep a public URL from incurring open-ended Anthropic /
# Google costs. Defaults to "false" so dev is frictionless.
AI_ALLOWLIST_ONLY=false

# Comma-separated Supabase auth.users.id UUIDs allowed to use AI
# when AI_ALLOWLIST_ONLY=true. Empty list + ALLOWLIST_ONLY=true means
# nobody, useful as an emergency lock. Pull your own uid from
# `supabase.auth.getUser()` in the browser console after login.
AI_ALLOWLIST_USER_IDS=

# ─── Content judge (TFG D3) ─────────────────────────────────────────
# LLM-as-judge filter that classifies note corpora before they reach
# summarise_notes' downstream LLM. Set to "false" to bypass the judge
# (Promptfoo baseline runs use this). Defaults to "true".
AI_JUDGE_ENABLED=true

# Judge confidence threshold for blocking. Verdict = "block" if any
# attack category triggers AND confidence >= this. Lower = more
# aggressive (more false positives), higher = more permissive. Range
# [0, 1]. Defaults to 0.7. Used by Promptfoo threshold sweep for §11.3.
AI_JUDGE_THRESHOLD=0.7
